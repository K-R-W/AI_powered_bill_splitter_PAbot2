# Secrets template for PA_bot2.
# Copy this file to .env and fill in your own credentials.
# The .env file is gitignored and read at build time into BuildConfig.

# Splitwise OAuth app credentials (https://secure.splitwise.com/apps)
SPLITWISE_CLIENT_ID=your_splitwise_client_id
SPLITWISE_CLIENT_SECRET=your_splitwise_client_secret

# Google OAuth server client ID (Google Cloud Console -> Credentials)
GOOGLE_SERVER_CLIENT_ID=your_google_server_client_id.apps.googleusercontent.com
